#!/bin/sh
# CLI wrapper: ./coord status, ./coord lock file --reason "...". Works from any directory.
SOURCE="$0"
while [ -h "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
UV="$(command -v uv || echo "$HOME/.local/bin/uv")"
if [ ! -x "$UV" ]; then
  echo "coordbot needs uv: run setup-mac.command first." >&2
  exit 1
fi
exec "$UV" run --quiet --project "$DIR" coordbot "$@"
